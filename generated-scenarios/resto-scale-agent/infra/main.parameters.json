{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environment": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "modelName": { "value": "${FOUNDRY_MODEL_NAME}" },
    "modelVersion": { "value": "${FOUNDRY_MODEL_VERSION}" },
    "modelDeploymentType": { "value": "${FOUNDRY_MODEL_DEPLOYMENT_TYPE}" },
    "foundryConsumerRoleId": { "value": "${FOUNDRY_CONSUMER_ROLE_ID}" }
  }
}
