  "NotAllowedResourceTypes": {
    "id": "/providers/Microsoft.Authorization/policyDefinitions/6c112d4e-5bc7-47ae-a041-ea2d9dccd749",
    "name": "6c112d4e-5bc7-47ae-a041-ea2d9dccd749",
    "properties": {
      "description": "Restrict which resource types can be deployed in your environment. Limiting resource types can reduce the complexity and attack surface of your environment while also helping to manage costs. Compliance results are only shown for non-compliant resources.",
      "displayName": "Not allowed resource types",
      "metadata": {
        "category": "General",
        "version": "2.0.0"
      },
      "mode": "All",
      "parameters": {
        "effect": {
          "allowedValues": [
            "Audit",
            "Deny",
            "Disabled"
          ],
          "defaultValue": "Deny",
          "metadata": {
            "description": "Enable or disable the execution of the policy",
            "displayName": "Effect"
          },
          "type": "String"
        },
        "listOfResourceTypesNotAllowed": {
          "metadata": {
            "description": "The list of resource types that cannot be deployed.",
            "displayName": "Not allowed resource types",
            "strongType": "resourceTypes"
          },
          "type": "Array"
        }
      },
      "policyRule": {
        "if": {
          "allOf": [
            {
              "field": "type",
              "in": "[parameters('listOfResourceTypesNotAllowed')]"
            },
            {
              "exists": true,
              "value": "[field('type')]"
            }
          ]
        },
        "then": {
          "effect": "[parameters('effect')]"
        }
      },
      "policyType": "BuiltIn",
      "version": "2.0.0",
      "versions": [
        "2.0.0"
      ]
    },
    "type": "Microsoft.Authorization/policyDefinitions"
  },
  "sys.mfa-write": {
    "id": "/providers/Microsoft.Authorization/policyDefinitions/54f51f64-eaa5-44cf-8674-830bcfd14d21",
    "name": "54f51f64-eaa5-44cf-8674-830bcfd14d21",
    "properties": {
      "description": "This policy definition blocks resource create and update operations when the caller is not authenticated via MFA. For more information, visit https://aka.ms/mfaforazure.",
      "displayName": "Multi Factor Authentication Enforcement - Write",
      "metadata": {
        "category": "System Policy",
        "version": "1.1.0"
      },
      "mode": "All",
      "parameters": {
        "effect": {
          "allowedValues": [
            "Audit",
            "Deny",
            "Disabled"
          ],
          "defaultValue": "Audit",
          "metadata": {
            "description": "The desired effect of the policy",
            "displayName": "Effect"
          },
          "type": "String"
        }
      },
      "policyRule": {
        "if": {
          "allOf": [
            {
              "equals": true,
              "value": "[contains(requestContext().identity, 'idtyp')]"
            },
            {
              "equals": "user",
              "value": "[requestContext().identity.idtyp]"
            },
            {
              "notIn": "[split(tryGet(requestContext().identity, 'http://schemas.microsoft.com/claims/authnmethodsreferences'), ',')]",
              "value": "mfa"
            },
            {
              "notIn": "[split(requestContext().identity.acrs, ',')]",
              "value": "p1"
            }
          ]
        },
        "then": {
          "effect": "[parameters('effect')]"
        }
      },
      "policyType": "BuiltIn",
      "version": "1.1.0",
      "versions": [
        "1.1.0",
        "1.0.0"
      ]
    },
    "type": "Microsoft.Authorization/policyDefinitions"
  },
  "sys.mfa-delete": {
    "id": "/providers/Microsoft.Authorization/policyDefinitions/f69cd8b8-9a6e-46b4-be84-244e8b127944",
    "name": "f69cd8b8-9a6e-46b4-be84-244e8b127944",
    "properties": {
      "description": "This policy definition blocks resource delete operations when the caller is not authenticated via MFA. For more information, visit https://aka.ms/mfaforazure.",
      "displayName": "Multi Factor Authentication Enforcement - Delete",
      "metadata": {
        "category": "System Policy",
        "version": "1.1.0"
      },
      "mode": "All",
      "parameters": {
        "effect": {
          "allowedValues": [
            "AuditAction",
            "DenyAction",
            "Disabled"
          ],
          "defaultValue": "AuditAction",
          "metadata": {
            "description": "The desired effect of the policy",
            "displayName": "Effect"
          },
          "type": "String"
        }
      },
      "policyRule": {
        "if": {
          "allOf": [
            {
              "equals": true,
              "value": "[contains(requestContext().identity, 'idtyp')]"
            },
            {
              "equals": "user",
              "value": "[requestContext().identity.idtyp]"
            },
            {
              "notIn": "[split(tryGet(requestContext().identity, 'http://schemas.microsoft.com/claims/authnmethodsreferences'), ',')]",
              "value": "mfa"
            },
            {
              "notIn": "[split(requestContext().identity.acrs, ',')]",
              "value": "p1"
            }
          ]
        },
        "then": {
          "details": {
            "actionNames": [
              "delete"
            ]
          },
          "effect": "[parameters('effect')]"
        }
      },
      "policyType": "BuiltIn",
      "version": "1.1.0",
      "versions": [
        "1.1.0",
        "1.0.0"
      ]
    },
    "type": "Microsoft.Authorization/policyDefinitions"
  },
  "5070a4f3c9d6554f993f8fef": {
    "id": "/providers/Microsoft.Management/managementGroups/16b3c013-d300-468d-ac64-7eda0820b6d3/providers/Microsoft.Authorization/policyDefinitions/zenity-foundry",
    "name": "zenity-foundry",
    "properties": {
      "description": "Adds Zenity's March 2026 US and EU IP addresses and the AzureServices trusted-services bypass to AIServices accounts with publicNetworkAccess Enabled and networkAcls.defaultAction Deny. Preserves existing IP rules, virtual-network rules, defaultAction, and publicNetworkAccess. Skips payloads without an explicit ipRules array to avoid replacing omitted existing rules during partial updates. Existing resources require a remediation task after enabling Modify.",
      "displayName": "Allow Zenity US and EU access to selected-network Foundry accounts",
      "metadata": {
        "category": "Cognitive Services",
        "createdBy": "d06df7d7-585d-4c03-8e6e-46de2f6974c7",
        "createdOn": "2026-10-09T05:52:11.9851857Z",
        "sourceIncident": "847007959",
        "updatedBy": "d06df7d7-585d-4c03-8e6e-46de2f6974c7",
        "updatedOn": "2026-10-09T06:00:05.5881869Z",
        "version": "1.0.0",
        "zenityIpListLastUpdated": "2026-03"
      },
      "mode": "Indexed",
      "parameters": {
        "effect": {
          "allowedValues": [
            "Audit",
            "Modify",
            "Disabled"
          ],
          "defaultValue": "Modify",
          "metadata": {
            "description": "Start with Audit. Use Modify only after reviewing compliance, testing on a pilot account, and granting the assignment identity its remediation role.",
            "displayName": "Effect"
          },
          "type": "String"
        },
        "zenityIpRules": {
          "defaultValue": [
            {
              "value": "18.119.43.115"
            },
            {
              "value": "3.136.223.195"
            },
            {
              "value": "3.147.3.200"
            },
            {
              "value": "3.17.222.94"
            },
            {
              "value": "3.150.94.181"
            },
            {
              "value": "3.132.250.211"
            },
            {
              "value": "18.116.189.61"
            },
            {
              "value": "3.147.9.237"
            },
            {
              "value": "34.240.215.149"
            },
            {
              "value": "52.210.88.12"
            },
            {
              "value": "52.213.253.68"
            },
            {
              "value": "34.252.144.198"
            },
            {
              "value": "52.210.148.44"
            },
            {
              "value": "54.195.128.224"
            },
            {
              "value": "18.200.62.37"
            },
            {
              "value": "52.31.196.233"
            },
            {
              "value": "108.128.206.229"
            },
            {
              "value": "99.81.56.225"
            }
          ],
          "metadata": {
            "description": "Individual source IPv4 addresses as objects with a value property. Defaults include both US and EU from Zenity's March 2026 documentation. Use bare IP addresses, not broader ranges.",
            "displayName": "Zenity source IP rules"
          },
          "type": "Array"
        }
      },
      "policyRule": {
        "if": {
          "allOf": [
            {
              "equals": "Microsoft.CognitiveServices/accounts",
              "field": "type"
            },
            {
              "equals": "AIServices",
              "field": "kind"
            },
            {
              "equals": "Enabled",
              "field": "Microsoft.CognitiveServices/accounts/publicNetworkAccess"
            },
            {
              "equals": "Deny",
              "field": "Microsoft.CognitiveServices/accounts/networkAcls.defaultAction"
            },
            {
              "exists": "true",
              "field": "Microsoft.CognitiveServices/accounts/networkAcls.ipRules"
            },
            {
              "anyOf": [
                {
                  "field": "Microsoft.CognitiveServices/accounts/networkAcls.bypass",
                  "notEquals": "AzureServices"
                },
                {
                  "count": {
                    "name": "zenityIpRule",
                    "value": "[parameters('zenityIpRules')]",
                    "where": {
                      "count": {
                        "field": "Microsoft.CognitiveServices/accounts/networkAcls.ipRules[*]",
                        "where": {
                          "anyOf": [
                            {
                              "equals": "[current('zenityIpRule').value]",
                              "field": "Microsoft.CognitiveServices/accounts/networkAcls.ipRules[*].value"
                            },
                            {
                              "equals": "[concat(current('zenityIpRule').value, '/32')]",
                              "field": "Microsoft.CognitiveServices/accounts/networkAcls.ipRules[*].value"
                            }
                          ]
                        }
                      },
                      "equals": 0
                    }
                  },
                  "greater": 0
                }
              ]
            }
          ]
        },
        "then": {
          "details": {
            "conflictEffect": "audit",
            "operations": [
              {
                "field": "Microsoft.CognitiveServices/accounts/networkAcls.ipRules",
                "operation": "addOrReplace",
                "value": "[union(field('Microsoft.CognitiveServices/accounts/networkAcls.ipRules'), parameters('zenityIpRules'))]"
              },
              {
                "field": "Microsoft.CognitiveServices/accounts/networkAcls.bypass",
                "operation": "addOrReplace",
                "value": "AzureServices"
              }
            ],
            "roleDefinitionIds": [
              "/providers/Microsoft.Authorization/roleDefinitions/25fbc0a9-bd7c-42a3-aa1a-3b75d497ee68"
            ]
          },
          "effect": "[parameters('effect')]"
        }
      },
      "policyType": "Custom",
      "version": "1.0.1",
      "versions": [
        "1.0.1",
        "1.0.0"
      ]
    },
