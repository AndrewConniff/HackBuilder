  "AzureOpenAI_ProvisionedCapacity_Deny": {
    "definition": {
      "id": "/providers/Microsoft.Management/managementGroups/08cc2a62-5116-449e-bed1-98c29bd48de7/providers/Microsoft.Authorization/policyDefinitions/AzureOpenAI_ProvisionedCapacity_Deny",
      "name": "AzureOpenAI_ProvisionedCapacity_Deny",
      "properties": {
        "description": "Deny the Azure OpenAI Deployments with Provisioned Capacity",
        "displayName": "Block Azure OpenAI Provisioned Capacity",
        "metadata": {
          "Version": "20261008-1",
          "category": "Cognitive Services",
          "createdBy": "0bc12465-ad34-4ee9-9d73-d6b23dfc78b8",
          "createdOn": "2024-09-27T01:03:04.3436664Z",
          "updatedBy": "4619a992-000c-420a-97c5-fa7fd7c0d2b2",
          "updatedOn": "2026-10-10T01:00:15.8153499Z"
        },
        "mode": "All",
        "parameters": {},
        "policyRule": {
          "if": {
            "AllOf": [
              {
                "equals": "Microsoft.CognitiveServices/accounts/deployments",
                "field": "type"
              },
              {
                "equals": "ProvisionedManaged",
                "field": "Microsoft.CognitiveServices/accounts/deployments/sku.name"
              }
            ]
          },
          "then": {
            "effect": "Deny"
          }
        },
        "policyType": "Custom",
        "version": "1.0.0",
        "versions": [
          "1.0.0"
        ]
      },
      "systemData": {
        "createdAt": "2024-09-27T01:03:04.2986096Z",
        "createdBy": "eadea216-1d5c-4a4b-beaf-4f145e6b1cb4",
        "createdByType": "Application",
        "lastModifiedAt": "2026-10-10T01:00:15.7924777Z",
        "lastModifiedBy": "a1a9c5b6-7a4f-4288-89ab-6805873f65d1",
        "lastModifiedByType": "Application"
      },
      "type": "Microsoft.Authorization/policyDefinitions"
    },
    "initiativeParameters": {}
