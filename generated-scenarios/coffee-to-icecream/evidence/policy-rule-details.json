  "AIFoundryHub_PublicNetwork_Modify": {
    "definition": {
      "id": "/providers/Microsoft.Management/managementGroups/08cc2a62-5116-449e-bed1-98c29bd48de7/providers/Microsoft.Authorization/policyDefinitions/AIFoundryHub_PublicNetwork_Modify",
      "name": "AIFoundryHub_PublicNetwork_Modify",
      "properties": {
        "displayName": "AzTB 16 - Public network access on Azure AI Foundry must be disabled or restricted",
        "metadata": {
          "Version": "20261008-1",
          "category": "Network",
          "createdBy": "0bc12465-ad34-4ee9-9d73-d6b23dfc78b8",
          "createdOn": "2025-12-09T01:00:30.7979682Z",
          "updatedBy": "4619a992-000c-420a-97c5-fa7fd7c0d2b2",
          "updatedOn": "2026-10-10T01:00:15.872398Z"
        },
        "mode": "Indexed",
        "parameters": {
          "AllowedTagName": {
            "defaultValue": "SecurityControl",
            "metadata": {
              "description": "Rule is not applied if this tag exists on the resource or resource group level",
              "displayName": "Exclusion Tag Name"
            },
            "type": "String"
          },
          "AllowedTagValue": {
            "defaultValue": "Ignore",
            "metadata": {
              "description": "Rule is not applied if this tag exists on the resource or resource group level",
              "displayName": "Exclusion Tag Value"
            },
            "type": "String"
          },
          "effect": {
            "allowedValues": [
              "audit",
              "deny",
              "modify"
            ],
            "defaultValue": "modify",
            "metadata": {
              "description": "The effect determines what happens when the policy rule is evaluated to match",
              "displayName": "Effect"
            },
            "type": "String"
          }
        },
        "policyRule": {
          "if": {
            "allOf": [
              {
                "equals": "Microsoft.MachineLearningServices/workspaces",
                "field": "type"
              },
              {
                "field": "Microsoft.MachineLearningServices/workspaces/publicNetworkAccess",
                "notEquals": "Disabled"
              },
              {
                "equals": "Hub",
                "field": "kind"
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "equals": "[parameters('AllowedTagValue')]",
                      "field": "[concat('tags[', parameters('AllowedTagName'), ']')]"
                    },
                    {
                      "equals": "[parameters('AllowedTagValue')]",
                      "value": "[resourceGroup().tags[parameters('AllowedTagName')]]"
                    }
                  ]
                }
              }
            ]
          },
          "then": {
            "details": {
              "conflictEffect": "audit",
              "operations": [
                {
                  "condition": "[greaterOrEquals(requestContext().apiVersion, '2021-10-01')]",
                  "field": "Microsoft.MachineLearningServices/workspaces/publicNetworkAccess",
                  "operation": "addOrReplace",
                  "value": "Disabled"
                }
              ],
              "roleDefinitionIds": [
                "/providers/microsoft.authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
              ]
            },
            "effect": "[parameters('effect')]"
          }
        },
        "policyType": "Custom",
        "version": "1.0.0",
        "versions": [
          "1.0.0"
        ]
      },
      "systemData": {
        "createdAt": "2025-12-09T01:00:30.7588277Z",
        "createdBy": "eadea216-1d5c-4a4b-beaf-4f145e6b1cb4",
        "createdByType": "Application",
        "lastModifiedAt": "2026-10-10T01:00:15.8092971Z",
        "lastModifiedBy": "a1a9c5b6-7a4f-4288-89ab-6805873f65d1",
        "lastModifiedByType": "Application"
      },
      "type": "Microsoft.Authorization/policyDefinitions"
    },
    "initiativeParameters": {}
  },
  "StorageAccount_PublicNetwork_Modify": {
    "definition": {
      "id": "/providers/Microsoft.Management/managementGroups/08cc2a62-5116-449e-bed1-98c29bd48de7/providers/Microsoft.Authorization/policyDefinitions/StorageAccount_PublicNetwork_Modify",
      "name": "StorageAccount_PublicNetwork_Modify",
      "properties": {
        "description": "Disables public network access on Storage accounts to comply with the SFI KPI. Resources secured by a Network Security Perimeter (publicNetworkAccess = SecuredByPerimeter) are excluded and their networking is not modified.",
        "displayName": "SFI-NS2.2.1 Secure PaaS Resources - Storage accounts (excluding NSP configured resources)",
        "metadata": {
          "Version": "20261008-1",
          "category": "Network",
          "createdBy": "0bc12465-ad34-4ee9-9d73-d6b23dfc78b8",
          "createdOn": "2026-07-09T01:00:23.3528694Z",
