          "updatedOn": "2026-10-10T01:00:15.8814679Z"
        },
        "mode": "Indexed",
        "parameters": {
          "AllowedTagName": {
            "defaultValue": "SecurityControl",
            "metadata": {
              "description": "Rule is not applied if this tag exists on the resource or resource group level",
              "displayName": "Exclusion Tag Name"
            },
            "type": "String"
          },
          "AllowedTagValue": {
            "defaultValue": "Ignore",
            "metadata": {
              "description": "Rule is not applied if this tag exists on the resource or resource group level",
              "displayName": "Exclusion Tag Value"
            },
            "type": "String"
          },
          "effect": {
            "allowedValues": [
              "audit",
              "deny",
              "modify"
            ],
            "defaultValue": "modify",
            "metadata": {
              "description": "The effect determines what happens when the policy rule is evaluated to match",
              "displayName": "Effect"
            },
            "type": "String"
          }
        },
        "policyRule": {
          "if": {
            "allOf": [
              {
                "equals": "Microsoft.Storage/storageAccounts",
                "field": "type"
              },
              {
                "field": "Microsoft.Storage/storageAccounts/publicNetworkAccess",
                "notEquals": "Disabled"
              },
              {
                "field": "Microsoft.Storage/storageAccounts/publicNetworkAccess",
                "notEquals": "SecuredByPerimeter"
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "equals": "[parameters('AllowedTagValue')]",
                      "field": "[concat('tags[', parameters('AllowedTagName'), ']')]"
                    },
                    {
                      "equals": "[parameters('AllowedTagValue')]",
                      "value": "[resourceGroup().tags[parameters('AllowedTagName')]]"
                    }
                  ]
                }
              }
            ]
          },
          "then": {
            "details": {
              "conflictEffect": "audit",
              "operations": [
                {
                  "condition": "[greaterOrEquals(requestContext().apiVersion, '2021-04-01')]",
                  "field": "Microsoft.Storage/storageAccounts/publicNetworkAccess",
                  "operation": "addOrReplace",
                  "value": "Disabled"
                }
              ],
              "roleDefinitionIds": [
                "/providers/microsoft.authorization/roleDefinitions/17d1049b-9a84-46fb-8f53-869881c3d3ab"
              ]
            },
            "effect": "[parameters('effect')]"
          }
        },
        "policyType": "Custom",
        "version": "1.0.0",
        "versions": [
          "1.0.0"
        ]
      },
      "systemData": {
        "createdAt": "2026-07-09T01:00:23.2900505Z",
        "createdBy": "eadea216-1d5c-4a4b-beaf-4f145e6b1cb4",
