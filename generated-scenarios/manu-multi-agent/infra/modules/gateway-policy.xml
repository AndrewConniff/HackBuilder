<policies>
  <inbound>
    <base />
    <set-variable name="correlationId" value="@(Guid.NewGuid().ToString())" />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
    <rate-limit-by-key calls="12" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
    <rate-limit-by-key calls="120" renewal-period="60" counter-key="mobility-commercial-global" />
    <set-header name="Authorization" exists-action="delete" />
    <authentication-managed-identity resource="__BACKEND_RESOURCE__" client-id="__GATEWAY_CLIENT_ID__" />
  </inbound>
  <backend>
    <forward-request timeout="95" fail-on-error-status-code="false" />
  </backend>
  <outbound>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
    <set-header name="Cache-Control" exists-action="override">
      <value>no-store</value>
    </set-header>
    <set-header name="X-Content-Type-Options" exists-action="override">
      <value>nosniff</value>
    </set-header>
  </outbound>
  <on-error>
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", context.RequestId.ToString()))</value>
    </set-header>
    <choose>
      <when condition="@(context.LastError.Reason == &quot;RateLimitExceeded&quot;)">
        <return-response>
          <set-status code="429" reason="Too Many Requests" />
          <set-header name="X-Correlation-ID" exists-action="override">
            <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", context.RequestId.ToString()))</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
          <set-header name="Retry-After" exists-action="override"><value>60</value></set-header>
          <set-body>@(new JObject(new JProperty("code", "rate_limit"), new JProperty("correlationId", context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", context.RequestId.ToString()))).ToString())</set-body>
        </return-response>
      </when>
      <when condition="@(context.LastError.Reason == &quot;OperationNotFound&quot;)">
        <return-response>
          <set-status code="404" reason="Not Found" />
          <set-header name="X-Correlation-ID" exists-action="override">
            <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", context.RequestId.ToString()))</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
          <set-body>@(new JObject(new JProperty("code", "route_not_found"), new JProperty("correlationId", context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", context.RequestId.ToString()))).ToString())</set-body>
        </return-response>
      </when>
      <otherwise>
        <return-response>
          <set-status code="503" reason="Service Unavailable" />
          <set-header name="X-Correlation-ID" exists-action="override">
            <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", context.RequestId.ToString()))</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
          <set-body>@(new JObject(new JProperty("code", "gateway_dependency_unavailable"), new JProperty("correlationId", context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", context.RequestId.ToString()))).ToString())</set-body>
        </return-response>
      </otherwise>
    </choose>
  </on-error>
</policies>
