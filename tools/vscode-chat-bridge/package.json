{
  "name": "scenario-chat",
  "displayName": "ABC Builder Scenario Chat",
  "description": "Link and reopen existing ABC Builder scenario and HackCreator conversations.",
  "publisher": "abcbuilder",
  "private": true,
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/petender/HackBuilder.git" },
  "version": "0.1.0",
  "engines": { "vscode": "^1.143.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "extensionKind": ["ui"],
  "activationEvents": ["onUri"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": {
    "commands": [
      { "command": "abcbuilder.linkChat", "title": "ABC Builder: Link Existing Chat to Scenario" }
    ]
  },
  "scripts": { "test": "node --test bridge.test.cjs" }
}
